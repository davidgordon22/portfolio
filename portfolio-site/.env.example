# Optional: semicolon-separated coarse locations that should receive a stronger alert label.
# Example: City A;City B
VISITOR_WATCH_LOCATIONS=

# Optional private label used only in server-side Slack alerts.
# Example: company-of-interest
VISITOR_WATCH_LABEL=

# Set true to alert on every engaged human visitor instead of only watched locations.
VISITOR_ALERT_ALL_HUMANS=false

# Slack Incoming Webhook URL for visitor alerts. Keep this secret and configure it in Vercel.
SLACK_VISITOR_WEBHOOK_URL=
